#include <windows.h>
#include "Resource.h"

/////////////////////////////////////////////////////////////////////////////
// Application icon
IDI_APPICON             ICON                    "app.ico"

/////////////////////////////////////////////////////////////////////////////
// Application manifest (RT_MANIFEST, CREATEPROCESS_MANIFEST_RESOURCE_ID).
// Provides Common Controls v6 + Per-Monitor V2 DPI awareness.
1                       24                      "app.manifest"

/////////////////////////////////////////////////////////////////////////////
// Settings dialog
IDD_SETTINGS DIALOGEX 0, 0, 280, 322
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Steam Sales Tray Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Steam Financial API key", -1, 7, 7, 266, 64
    EDITTEXT        IDC_EDIT_APIKEY, 14, 20, 252, 14, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "", IDC_STATIC_KEYSTATUS, 14, 37, 252, 8, SS_NOPREFIX
    CONTROL         "Show keys", IDC_CHECK_SHOWKEY, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 14, 52, 90, 10
    PUSHBUTTON      "Remove Key...", IDC_BUTTON_REMOVEKEY, 116, 50, 72, 14
    PUSHBUTTON      "Test Connection", IDC_BUTTON_TEST, 192, 50, 74, 14

    GROUPBOX        "Publisher Web API key (optional)", -1, 7, 77, 266, 64
    EDITTEXT        IDC_EDIT_PUBLISHER_APIKEY, 14, 90, 252, 14,
                    ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "", IDC_STATIC_PUBLISHER_KEYSTATUS, 14, 107, 252, 8,
                    SS_NOPREFIX
    PUSHBUTTON      "Remove Key...", IDC_BUTTON_REMOVE_PUBLISHERKEY,
                    194, 120, 72, 14

    GROUPBOX        "General", -1, 7, 147, 266, 70
    LTEXT           "Refresh interval:", -1, 14, 162, 62, 8
    COMBOBOX        IDC_COMBO_INTERVAL, 80, 160, 100, 90,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Start automatically when I sign in", IDC_CHECK_STARTUP,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 177, 252, 10
    CONTROL         "Notify me when new units are sold", IDC_CHECK_NOTIFY,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 189, 252, 10
    CONTROL         "Hide lifetime totals", IDC_CHECK_HIDELIFETIME,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 201, 252, 10

    GROUPBOX        "Local data", -1, 7, 223, 266, 54
    LTEXT           "Re-fetch the last", -1, 14, 239, 58, 8
    EDITTEXT        IDC_EDIT_RESYNC_DAYS, 74, 237, 26, 14,
                    ES_NUMBER | ES_AUTOHSCROLL | ES_CENTER
    LTEXT           "days from Steam", -1, 104, 239, 80, 8
    PUSHBUTTON      "Force Resync...", IDC_BUTTON_FORCERESYNC, 192, 237, 74, 14
    LTEXT           "Delete all cached sales and re-download everything",
                    -1, 14, 258, 176, 8
    PUSHBUTTON      "Clear Cache...", IDC_BUTTON_CLEARCACHE, 192, 256, 74, 14

    LTEXT           "", IDC_STATIC_TESTRESULT, 7, 283, 266, 16, SS_NOPREFIX
    DEFPUSHBUTTON   "Save", IDOK, 169, 301, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 223, 301, 50, 14
END

/////////////////////////////////////////////////////////////////////////////
// Version information
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Bezi"
            VALUE "FileDescription", "Steam Sales Tray"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "SteamSalesTray"
            VALUE "LegalCopyright", "Copyright (C) 2026 Bezi"
            VALUE "OriginalFilename", "SteamSalesTray.exe"
            VALUE "ProductName", "Steam Sales Tray"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
